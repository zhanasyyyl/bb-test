# Django secret key (required in production)
SECRET_KEY=change-me-to-a-random-50-char-string

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts (comma separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Resend API Key for email sending (https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# Number of gunicorn workers (keep in sync with gunicorn.conf.py); the email
# rate limit is split across them
EMAIL_SENDER_PROCESSES=9
