# Django secret key (required in production)
SECRET_KEY=change-me-to-a-random-50-char-string

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts (comma separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Telegram bot (create one with @BotFather): token, username without @, and
# any random string for the webhook secret. Then run: python manage.py telegram_setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Number of gunicorn workers (keep in sync with gunicorn.conf.py); the Telegram
# rate limit is split across them
MESSAGE_SENDER_PROCESSES=9
